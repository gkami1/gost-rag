# ---------- LLM (любой OpenAI-совместимый провайдер) ----------
# Пресеты: deepseek | qwen | yandex | custom
LLM_PROVIDER=deepseek
LLM_API_KEY=sk-...

# deepseek -> https://api.deepseek.com/v1        , модель deepseek-v4-flash
# qwen     -> https://dashscope-intl.aliyuncs.com/compatible-mode/v1, модель qwen-plus
# yandex   -> https://llm.api.cloud.yandex.net/v1, модель gpt://<folder>/yandexgpt-5.1/latest
# Раскомментируйте, чтобы переопределить пресет:
# LLM_BASE_URL=
# LLM_MODEL=
# LLM_FOLDER_ID=          # только для yandex

LLM_TEMPERATURE=0.1
LLM_MAX_TOKENS=1500

# ---------- Индекс ----------
# По умолчанию Qdrant работает встроенно (папка data/processed/qdrant).
# Для сервера укажите URL — код менять не нужно.
# QDRANT_URL=http://localhost:6333
# QDRANT_API_KEY=

# ---------- Поиск ----------
RERANK_TOP_N=6
RERANK_THRESHOLD=0.2

# ---------- OCR ----------
OCR_ENABLED=true
OCR_LANG=rus
# Windows: укажите путь, если tesseract не в PATH
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe

# ---------- Сервер ----------
HOST=127.0.0.1
PORT=8000
LOG_LEVEL=INFO
